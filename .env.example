# Copy to .env for local dev. Leave values blank to keep GA4 + Faro disabled
# locally (the site no-ops on empty). In CI the real values come from GitHub
# Actions secrets (PUBLIC_GA4_ID, PUBLIC_FARO_COLLECTOR_URL) set on the
# shipsolid-portfolio-deploy workflow — not from this file.

# Google Analytics 4 Measurement ID
# analytics.google.com → Admin → Data Streams → your stream → Measurement ID
# Format: G-XXXXXXXXXX
PUBLIC_GA4_ID=

# Grafana Cloud Frontend Observability (Faro) collector endpoint
# Grafana Cloud → Frontend Observability → your app → Web SDK Configuration
# Format: https://faro-collector-<region>.grafana.net/collect/<app-key>
PUBLIC_FARO_COLLECTOR_URL=
