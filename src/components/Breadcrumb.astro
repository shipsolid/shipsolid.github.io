---
// Shared breadcrumb trail. Six near-identical hand-rolled instances already
// existed across content pages before this component (none shared); the
// existing hand-rolled instances are left as-is, out of scope for this pass.
interface Crumb {
  label: string;
  href?: string; // omit on the last crumb — it renders as plain text, not a link
}
interface Props {
  items: Crumb[];
}
const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs font-mono text-faint mb-6 flex-wrap">
  {items.map((crumb, i) => (
    <>
      {crumb.href ? (
        <a href={crumb.href} class="hover:text-accent transition-colors">{crumb.label}</a>
      ) : (
        <span class="text-accent" aria-current="page">{crumb.label}</span>
      )}
      {i < items.length - 1 && <span aria-hidden="true">/</span>}
    </>
  ))}
</nav>
