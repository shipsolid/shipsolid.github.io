---

<section class="border-t border-line">
  <div class="section-container">
    <p class="section-label">Career</p>
    <h2 class="section-title">14 years of building things</h2>

    <div class="mt-12 relative">
      <!-- Vertical line -->
      <div class="absolute left-4 md:left-8 top-0 bottom-0 w-px bg-surface-hover"></div>

      <div class="space-y-10">
        {timeline.map(({ period, role, company, type, highlights, tags, impact }) => (
          <div class="relative pl-12 md:pl-20">
            <!-- Dot -->
            <div class={`absolute left-2.5 md:left-6 top-1 w-3 h-3 rounded-full border-2 ${
              type === 'current'
                ? 'bg-accent border-accent shadow-[0_0_12px_rgba(0,217,166,0.5)]'
                : 'bg-surface-hover border-line-hover'
            }`}></div>

            <!-- Year badge -->
            <div class="font-mono text-xs text-faint mb-2">{period}</div>

            <div class="card">
              <div class="flex flex-wrap items-start justify-between gap-2 mb-3">
                <div>
                  <h3 class="font-semibold text-ink">{role}</h3>
                  <p class="text-sm text-dim mt-0.5">{company}</p>
                </div>
                {type === 'current' && (
                  <span class="flex items-center gap-1.5 px-2.5 py-1 text-xs font-mono text-success bg-success/10 border border-success/20 rounded-full">
                    <span class="w-1.5 h-1.5 rounded-full bg-success animate-pulse"></span>
                    Current
                  </span>
                )}
              </div>

              <ul class="space-y-1.5 mb-4">
                {highlights.map((h) => (
                  <li class="flex items-start gap-2 text-sm text-muted">
                    <span class="text-accent/60 mt-1 flex-shrink-0">›</span>
                    {h}
                  </li>
                ))}
              </ul>

              {impact && (
                <div class="mb-4 px-3 py-2 rounded-lg bg-accent/5 border border-accent/15 text-xs text-accent/80 font-mono">
                  ✦ {impact}
                </div>
              )}

              <div class="flex flex-wrap gap-1.5 pt-3 border-t border-line">
                {tags.map((tag) => <span class="tag">{tag}</span>)}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
