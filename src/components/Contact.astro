---
const openTo = [
  'Principal / Staff Engineer roles',
  'Observability Architect positions',
  'MAANG & Tier-1 tech companies',
  'Conference talks & advisory',
  'Open-source collaboration',
];

const links = [
  {
    label: 'Email me',
    href: 'mailto:amitsingh007s@gmail.com',
    primary: true,
    icon: `<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>`,
  },
  {
    label: 'LinkedIn',
    href: 'https://linkedin.com/in/amitsingh007s',
    primary: false,
    icon: `<svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>`,
  },
  {
    label: 'GitHub',
    href: 'https://github.com/shipsolid',
    primary: false,
    icon: `<svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>`,
  },
];
---

<section id="contact" class="border-t border-line relative overflow-hidden">
  <!-- Ambient glow -->
  <div
    class="absolute inset-0 pointer-events-none"
    style="background: radial-gradient(ellipse 70% 50% at 50% 100%, rgba(0,217,166,0.05) 0%, transparent 70%)"
  ></div>

  <div class="section-container relative z-10 max-w-3xl">
    <p class="section-label">Contact</p>
    <h2 class="section-title">Let's connect</h2>

    <p class="mt-4 text-muted text-lg leading-relaxed max-w-xl">
      I'm actively exploring principal-level and staff engineering roles at MAANG and
      Tier-1 tech companies. If you're building something ambitious in the observability,
      reliability, or platform engineering space — let's talk.
    </p>

    <!-- Open to -->
    <div class="mt-10">
      <p class="text-xs font-mono text-faint uppercase tracking-widest mb-4">Open to</p>
      <div class="flex flex-wrap gap-3">
        {openTo.map((item) => (
          <div class="flex items-center gap-2 px-4 py-2.5 rounded-xl bg-surface border border-line hover:border-line-hover transition-colors">
            <span class="w-1.5 h-1.5 rounded-full bg-accent flex-shrink-0"></span>
            <span class="text-sm text-body">{item}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- CTAs -->
    <div class="mt-10 flex flex-wrap gap-3">
      {links.map(({ label, href, primary, icon }) => (
        <a
          href={href}
          target={href.startsWith('mailto') ? undefined : '_blank'}
          rel={href.startsWith('mailto') ? undefined : 'noopener noreferrer'}
          class={`flex items-center gap-2 ${primary ? 'btn-primary' : 'btn-outline'}`}
          set:html={`${icon}<span>${label}</span>`}
        />
      ))}
    </div>

    <!-- Location note -->
    <p class="mt-8 text-xs font-mono text-faint flex items-center gap-2">
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
      </svg>
      Based in India (IST, UTC+5:30) · Open to remote globally
    </p>
  </div>
</section>
