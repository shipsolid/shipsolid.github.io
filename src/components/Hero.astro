---
// No props — all content is static
---

<section
  id="hero"
  class="relative min-h-screen flex items-center bg-bg overflow-hidden"
>
  <!-- Grid background -->
  <div class="absolute inset-0 bg-grid-overlay bg-grid opacity-100 pointer-events-none"></div>

  <!-- Radial gradient vignette -->
  <div
    class="absolute inset-0 pointer-events-none"
    style="background: radial-gradient(ellipse 80% 60% at 50% 0%, rgba(0,217,166,0.06) 0%, transparent 70%)"
  ></div>

  <div class="section-container relative z-10 grid md:grid-cols-2 gap-12 items-center pt-20">
    <!-- Left: intro text -->
    <div class="animate-fade-in">
      <p class="font-mono text-accent text-sm mb-4 flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-accent animate-pulse inline-block"></span>
        // observability architect
      </p>

      <h1 class="text-5xl md:text-6xl font-bold text-ink leading-tight tracking-tight">
        Amit<br />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-accent to-teal-300">Singh</span>
      </h1>

      <div class="mt-4 h-8 flex items-center">
        <span class="font-mono text-muted text-lg">
          <span id="typewriter"></span><span class="text-accent animate-blink">▌</span>
        </span>
      </div>

      <p class="mt-6 text-muted text-base leading-relaxed max-w-md">
        14+ years building developer and observability platforms across global financial and
        enterprise organisations. M.Tech, BITS Pilani. Patent holder. 8+ industry awards.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/#projects" class="btn-primary">View Projects</a>
        <a href="/blog" class="btn-outline">Read Blog</a>
      </div>

      <div class="mt-10 flex flex-wrap gap-x-6 gap-y-2">
        {[
          { label: 'Years', value: '14+' },
          { label: 'MTTD reduction', value: '90%' },
          { label: 'MTTR reduction', value: '70%' },
          { label: 'Cost savings', value: '$1.5M+/yr' },
        ].map(({ label, value }) => (
          <div class="flex flex-col">
            <span class="text-xl font-bold text-accent font-mono">{value}</span>
            <span class="text-xs text-faint uppercase tracking-wider">{label}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Right: terminal card -->
    <div class="animate-fade-in" style="animation-delay: 0.2s; opacity: 0;">
      <div class="bg-surface/80 backdrop-blur rounded-2xl border border-line-hover/50 overflow-hidden shadow-2xl shadow-black/40 light:shadow-black/10">
        <!-- Title bar -->
        <div class="flex items-center gap-2 px-4 py-3 bg-surface-hover/60 border-b border-line-hover/50">
          <span class="w-3 h-3 rounded-full bg-red-500/70"></span>
          <span class="w-3 h-3 rounded-full bg-yellow-500/70"></span>
          <span class="w-3 h-3 rounded-full bg-green-500/70"></span>
          <span class="ml-3 text-muted text-xs font-mono">grafana-cloud ❯ mccain-global</span>
        </div>

        <!-- Terminal body -->
        <div class="p-6 font-mono text-sm space-y-4">
          <div>
            <span class="text-faint">$ </span>
            <span class="text-body">query --scope=career --metric=impact</span>
          </div>

          <div class="space-y-1.5 pl-3 border-l border-line">
            <div class="flex justify-between gap-8">
              <span class="text-dim">onboarding_time &nbsp;&nbsp;&nbsp;&nbsp;</span>
              <span class="text-accent font-semibold">3d → 30 min ↓96%</span>
            </div>
            <div class="flex justify-between gap-8">
              <span class="text-dim">mttd_reduction &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span>
              <span class="text-accent">90%</span>
            </div>
            <div class="flex justify-between gap-8">
              <span class="text-dim">mttr_reduction &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span>
              <span class="text-accent">70%</span>
            </div>
          </div>

          <div class="space-y-1.5 pl-3 border-l border-line">
            <div class="flex justify-between gap-8">
              <span class="text-dim">cost_savings &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span>
              <span class="text-accent">$1.5M+/year</span>
            </div>
            <div class="flex justify-between gap-8">
              <span class="text-dim">engineers_trained &nbsp;&nbsp;</span>
              <span class="text-accent">50+</span>
            </div>
            <div class="flex justify-between gap-8">
              <span class="text-dim">patent.status &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span>
              <span class="text-accent">IN + US ✓</span>
            </div>
            <div class="flex justify-between gap-8">
              <span class="text-dim">awards &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span>
              <span class="text-accent">8+ ✓</span>
            </div>
          </div>

          <div class="text-faint">
            <span>// </span>
            <span class="text-dim">Reactive → Resilient → Autonomous</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-1 text-faint animate-bounce">
    <span class="text-xs font-mono">scroll</span>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
    </svg>
  </div>
</section>

<script>
const roles = [
  'Observability Architect',
  'SRE & Platform Engineer',
  'Distributed Systems Thinker',
  'Building Autonomous Reliability',
];

let roleIdx = 0;
let charIdx = 0;
let deleting = false;
const el = document.getElementById('typewriter');
if (!el) throw new Error('typewriter element not found');

// Never run the never-ending type/delete loop for readers who ask for reduced
// motion (WCAG 2.2.2) — just show the first role, statically.
const reduceMotion = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches;

function tick() {
  const current = roles[roleIdx];
  if (deleting) {
    charIdx--;
  } else {
    charIdx++;
  }

  el!.textContent = current.slice(0, charIdx); // non-null: the `if (!el) throw` above guarantees el is set

  if (!deleting && charIdx === current.length) {
    setTimeout(() => { deleting = true; tick(); }, 2200);
    return;
  }
  if (deleting && charIdx === 0) {
    deleting = false;
    roleIdx = (roleIdx + 1) % roles.length;
  }

  setTimeout(tick, deleting ? 45 : 80);
}

if (reduceMotion) {
  el.textContent = roles[0];
} else {
  tick();
}
</script>
