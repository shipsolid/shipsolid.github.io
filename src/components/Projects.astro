---
import type { CollectionEntry } from 'astro:content';

interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;

const statusColor: Record<string, string> = {
  active: 'text-success bg-success/10 border-success/20',
  wip: 'text-yellow-400 bg-yellow-400/10 border-yellow-400/20',
  archived: 'text-dim bg-dim/10 border-dim/20',
};

const statusLabel: Record<string, string> = {
  active: 'Active',
  wip: 'WIP',
  archived: 'Archived',
};
---

<section id="projects" class="border-t border-line">
  <div class="section-container">

    <div class="flex items-end justify-between mb-10">
      <div>
        <p class="section-label">Projects</p>
        <h2 class="section-title">Things I've built</h2>
      </div>
      <a href="/projects" class="text-sm text-accent hover:text-accent-hover font-mono transition-colors hidden sm:flex items-center gap-1.5">
        View all
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      </a>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {projects.map((project) => (
        <article class="card group relative flex flex-col gap-4 hover:-translate-y-0.5">

          <!-- Header -->
          <div class="flex items-start justify-between gap-3">
            <h3 class="font-semibold text-ink text-base leading-snug group-hover:text-accent transition-colors">
              <a href={project.data.externalUrl ?? `/projects/${project.id}`} class="after:absolute after:inset-0 after:content-['']">
                {project.data.title}
              </a>
            </h3>
            <span class={`flex-shrink-0 px-2 py-0.5 text-xs font-mono rounded-full border ${statusColor[project.data.status]}`}>
              {statusLabel[project.data.status]}
            </span>
          </div>

          <!-- Description -->
          <p class="text-sm text-muted leading-relaxed flex-1">{project.data.description}</p>

          <!-- Tags -->
          <div class="flex flex-wrap gap-1.5">
            {project.data.tags.slice(0, 5).map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </div>

          <!-- Links -->
          <div class="flex items-center gap-3 pt-2 border-t border-line relative z-10">
            {project.data.github && (
              <a
                href={project.data.github}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-1.5 text-xs text-dim hover:text-body transition-colors font-mono"
              >
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                </svg>
                Source
              </a>
            )}
            {project.data.demo && (
              <a
                href={project.data.demo}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-1.5 text-xs text-dim hover:text-accent transition-colors font-mono"
              >
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                </svg>
                Demo
              </a>
            )}
          </div>

        </article>
      ))}
    </div>

    <div class="mt-8 flex sm:hidden">
      <a href="/projects" class="btn-outline w-full text-center">View all projects</a>
    </div>

  </div>
</section>
