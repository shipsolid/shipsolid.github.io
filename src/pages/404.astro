---
import Page from '../layouts/Page.astro';

const links = [
  { href: '/', label: 'Home' },
  { href: '/blog', label: 'Blog' },
  { href: '/tools', label: 'Tools' },
  { href: 'https://gita.shipsolid.workers.dev/', label: 'Bhagavad Gita', external: true },
  { href: '/search', label: 'Search' },
];
---

<Page
  title="Page not found — Amit Singh"
  description="The page you were looking for doesn't exist or has moved."
>
  <div class="max-w-9xl mx-auto px-6">
      <p class="section-label">404</p>
      <h1 class="text-4xl font-bold text-ink mt-2">Page not found</h1>
      <p class="text-muted mt-4 max-w-prose">
        The page you were looking for doesn't exist or has moved. Try one of these:
      </p>
      <nav aria-label="Site sections" class="mt-8 flex flex-wrap gap-3">
        {links.map(({ href, label, external }) => (
          <a
            href={href}
            target={external ? '_blank' : undefined}
            rel={external ? 'noopener noreferrer' : undefined}
            class="btn-outline"
          >{label}</a>
        ))}
      </nav>
    </div>
</Page>
