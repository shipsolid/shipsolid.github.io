---
import { getCollection } from 'astro:content';
import Page from '../../layouts/Page.astro';
import FlashcardStudySession from '../../components/FlashcardStudySession.astro';
import { expandReviewUnits } from '../../lib/srs/units';
import { renderReviewUnits } from '../../lib/content/render-card';

export async function getStaticPaths() {
  const decks = await getCollection('flashcards');
  return decks.map((entry) => ({
    params: { deck: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { title, description, tags, cards } = entry.data;
const deckSlug = entry.id;
const reviewUnits = expandReviewUnits(cards);
const resolvedUnits = await renderReviewUnits(cards, reviewUnits, deckSlug);

// Breadcrumb: "patterns/fan-out-fan-in" → [{label, href}, ..., {label}]
const parts = deckSlug.split('/');
const breadcrumbs = parts.map((part, i) => ({
  label: part,
  href: i < parts.length - 1 ? '/flashcards' : null,
}));
---

<Page title={`${title} — Flashcards`} description={description} mainClass="min-h-screen">
  <div class="max-w-7xl mx-auto px-6">
      <!-- Breadcrumb -->
      <nav class="mb-8 text-sm font-mono text-faint flex items-center flex-wrap gap-1">
        <a href="/flashcards" class="hover:text-muted transition-colors">flashcards</a>
        {breadcrumbs.map(({ label, href }) => (
          <>
            <span class="mx-1">/</span>
            {href
              ? <a href={href} class="hover:text-muted transition-colors">{label}</a>
              : <span class="text-muted">{label}</span>
            }
          </>
        ))}
      </nav>

      <!-- Deck header -->
      <div class="mb-6 flex items-start justify-between gap-4">
        <div>
          <h1 class="text-2xl font-bold text-ink mb-1">{title}</h1>
          {description && <p class="text-sm text-dim">{description}</p>}
        </div>
        <a
          id="mode-toggle"
          href={`/flashcards/${deckSlug}?mode=cram`}
          class="text-xs font-mono text-faint hover:text-muted transition-colors shrink-0 mt-1 whitespace-nowrap"
        >
          study all (cram) &rarr;
        </a>
      </div>

      <FlashcardStudySession resolvedUnits={resolvedUnits} />

      <!-- Tags -->
      {tags.length > 0 && (
        <div class="mt-8 flex flex-wrap gap-2 justify-center">
          {tags.map((tag) => <span class="tag text-[11px]">{tag}</span>)}
        </div>
      )}

    </div>

</Page>
