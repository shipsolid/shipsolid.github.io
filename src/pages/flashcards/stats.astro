---
import { getCollection } from 'astro:content';
import Page from '../../layouts/Page.astro';
import { expandReviewUnits } from '../../lib/srs/units';

const allDecks = await getCollection('flashcards');
const deckMeta = allDecks
  .map((deck) => ({
    slug: deck.id,
    title: deck.data.title,
    tags: deck.data.tags,
    totalReviewUnits: expandReviewUnits(deck.data.cards).length,
  }))
  .sort((a, b) => a.title.localeCompare(b.title));

// <script> is an HTML "raw text" element — a literal `</script>` inside embedded JSON would
// prematurely close the tag if not guarded; Astro's default `{expr}` escaping doesn't protect
// against this specifically inside <script>, since raw-text elements aren't entity-decoded the
// way normal text nodes are. set:html + a manual `<` escape is the standard safe pattern.
const dataIslandJson = JSON.stringify({ deckMeta }).replace(/</g, '\\u003c');
---

<Page
  title="Stats — Flashcards"
  description="Spaced-repetition analytics: streaks, heatmap, mastery, and forecast across every deck."
 mainClass="min-h-screen">
  <div class="max-w-7xl mx-auto px-6">
      <nav class="mb-8 text-sm font-mono text-faint flex items-center flex-wrap gap-1">
        <a href="/flashcards" class="hover:text-muted transition-colors">flashcards</a>
        <span class="mx-1">/</span>
        <span class="text-muted">stats</span>
      </nav>

      <div class="mb-10">
        <p class="section-label">Stats</p>
        <h1 class="text-4xl font-bold text-ink mt-2">Review Analytics</h1>
        <p class="text-muted mt-3 max-w-lg">
          Streaks, recall accuracy, mastery, and what's coming due — across every deck.
        </p>
      </div>

      <div class="tabs" role="tablist">
        <button class="tab" data-tab="overview" role="tab" aria-selected="true" type="button">Overview</button>
        <button class="tab" data-tab="decks-tags" role="tab" aria-selected="false" type="button">Decks &amp; Tags</button>
        <button class="tab" data-tab="achievements" role="tab" aria-selected="false" type="button">Achievements</button>
      </div>

      <div id="stats-panel-overview" role="tabpanel">
        <div id="stats-empty" class="hidden card text-center py-16">
          <p class="text-dim font-mono">// No reviews yet — study a deck to see stats here</p>
        </div>

        <div id="stats-content">
          <!-- Hero streak -->
          <div class="card text-center py-8 mb-8">
            <div class="text-5xl font-bold text-accent font-mono" id="stat-streak-hero">0</div>
            <div class="mt-2 text-sm text-dim">day streak</div>
            <div class="mt-3 text-xs font-mono text-faint" id="stat-learning-counts-caption"></div>
          </div>

          <!-- Heatmap -->
          <div class="card p-6 mb-8">
            <p class="text-xs font-mono text-dim uppercase tracking-widest mb-4">Review Activity</p>
            <div class="stats-heatmap-wrap">
              <div class="stats-heatmap" id="stats-heatmap"></div>
            </div>
          </div>

          <!-- Stat tiles -->
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
            <div class="card text-center">
              <div class="text-2xl font-bold text-accent font-mono" id="stat-reviews-today">—</div>
              <div class="mt-1 text-xs text-dim">Reviews Today</div>
            </div>
            <div class="card text-center">
              <div class="text-2xl font-bold text-accent font-mono" id="stat-day-streak">—</div>
              <div class="mt-1 text-xs text-dim">Day Streak</div>
            </div>
            <div class="card text-center">
              <div class="text-2xl font-bold text-accent font-mono" id="stat-recall-accuracy">—</div>
              <div class="mt-1 text-xs text-dim">Recall Accuracy (30d)</div>
              <div class="mt-0.5 text-[11px] text-faint" id="stat-recall-accuracy-sub"></div>
            </div>
            <div class="card text-center">
              <div class="text-2xl font-bold text-accent font-mono" id="stat-avg-response">—</div>
              <div class="mt-1 text-xs text-dim">Avg Response (30d)</div>
              <div class="mt-0.5 text-[11px] text-faint" id="stat-avg-response-sub"></div>
            </div>
          </div>

          <!-- Forecast -->
          <div class="card p-6 mb-8">
            <p class="text-xs font-mono text-dim uppercase tracking-widest mb-4">Next 14 Days</p>
            <div class="stats-forecast" id="stats-forecast"></div>
          </div>

          <!-- Trends -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="card p-6">
              <p class="text-xs font-mono text-dim uppercase tracking-widest mb-4">Reviews / Day (30d trend)</p>
              <div class="stats-sparkline" id="stats-trend-reviews"></div>
            </div>
            <div class="card p-6">
              <p class="text-xs font-mono text-dim uppercase tracking-widest mb-4">Recall Accuracy (30d trend)</p>
              <div class="stats-sparkline" id="stats-trend-accuracy"></div>
            </div>
          </div>
        </div>
      </div>

      <div id="stats-panel-decks-tags" role="tabpanel" class="hidden">
        <div class="mb-8">
          <p class="text-xs font-mono text-dim uppercase tracking-widest mb-3">Decks</p>
          <div class="overflow-x-auto">
            <table class="stats-table" id="stats-decks-table">
              <thead>
                <tr>
                  <th data-sort="label">Name</th>
                  <th data-sort="totalReviewUnits">Cards</th>
                  <th data-sort="matureCount">Mature</th>
                  <th data-sort="masteryScore">Mastery</th>
                  <th data-sort="confidenceScore">Confidence</th>
                  <th data-sort="nextDueCount">Due</th>
                </tr>
              </thead>
              <tbody></tbody>
            </table>
          </div>
        </div>
        <div>
          <p class="text-xs font-mono text-dim uppercase tracking-widest mb-3">Tags</p>
          <div class="overflow-x-auto">
            <table class="stats-table" id="stats-tags-table">
              <thead>
                <tr>
                  <th data-sort="label">Name</th>
                  <th data-sort="totalReviewUnits">Cards</th>
                  <th data-sort="matureCount">Mature</th>
                  <th data-sort="masteryScore">Mastery</th>
                  <th data-sort="confidenceScore">Confidence</th>
                  <th data-sort="nextDueCount">Due</th>
                </tr>
              </thead>
              <tbody></tbody>
            </table>
          </div>
        </div>
      </div>

      <div id="stats-panel-achievements" role="tabpanel" class="hidden">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
          <div class="card text-center">
            <div class="text-2xl font-bold text-accent font-mono" id="gamify-stat-level">1</div>
            <div class="mt-1 text-xs text-dim">Level</div>
          </div>
          <div class="card text-center">
            <div class="text-2xl font-bold text-accent font-mono" id="gamify-stat-xp">0</div>
            <div class="mt-1 text-xs text-dim">Total XP</div>
          </div>
          <div class="card text-center">
            <div class="text-2xl font-bold text-accent font-mono" id="gamify-stat-reviews">0</div>
            <div class="mt-1 text-xs text-dim">Reviews All-Time</div>
          </div>
          <div class="card text-center">
            <div class="text-2xl font-bold text-accent font-mono" id="gamify-stat-badges">0/0</div>
            <div class="mt-1 text-xs text-dim">Badges Unlocked</div>
          </div>
        </div>

        <div class="card p-6 mb-8">
          <p class="text-xs font-mono text-dim uppercase tracking-widest mb-4">Goals</p>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <div class="flex items-center justify-between mb-2">
                <label for="goal-daily-input" class="text-sm text-body">Daily reviews</label>
                <input
                  id="goal-daily-input"
                  type="number"
                  min="1"
                  class="w-16 bg-surface border border-line-hover rounded-lg px-2 py-1 text-sm text-ink text-right"
                />
              </div>
              <div class="h-1.5 bg-surface-hover rounded-full overflow-hidden mb-1">
                <div id="goal-daily-bar" class="h-full bg-accent rounded-full transition duration-500" style="width: 0%"></div>
              </div>
              <p class="text-xs font-mono text-faint" id="goal-daily-label"></p>
            </div>
            <div>
              <div class="flex items-center justify-between mb-2">
                <label for="goal-weekly-input" class="text-sm text-body">Weekly Challenge — days/week</label>
                <input
                  id="goal-weekly-input"
                  type="number"
                  min="1"
                  max="7"
                  class="w-16 bg-surface border border-line-hover rounded-lg px-2 py-1 text-sm text-ink text-right"
                />
              </div>
              <div class="h-1.5 bg-surface-hover rounded-full overflow-hidden mb-1">
                <div id="goal-weekly-bar" class="h-full bg-accent rounded-full transition duration-500" style="width: 0%"></div>
              </div>
              <p class="text-xs font-mono text-faint" id="goal-weekly-label"></p>
            </div>
          </div>
        </div>

        <div>
          <p class="text-xs font-mono text-dim uppercase tracking-widest mb-4">Badges</p>
          <div class="badge-grid" id="badge-grid"></div>
        </div>
      </div>

    </div>

</Page>

<script type="application/json" id="fc-stats-data" set:html={dataIslandJson}></script>

<style>
  /* Required by the @apply rules below — see the note in search.astro. */
  @reference '../../styles/global.css';

  .stats-heatmap-wrap {
    @apply overflow-x-auto;
  }
  .stats-heatmap {
    display: grid;
    grid-template-rows: repeat(7, 1fr);
    grid-auto-flow: column;
    grid-auto-columns: minmax(10px, 1fr);
    gap: 3px;
    min-width: 640px;
  }
  .stats-heatmap-cell {
    aspect-ratio: 1;
    border-radius: 2px;
    border-width: 1px;
  }
  .stats-heatmap-cell[data-level='0'] { @apply bg-surface border-line; }
  .stats-heatmap-cell[data-level='1'] { @apply bg-accent-muted border-transparent; }
  .stats-heatmap-cell[data-level='2'] { @apply bg-accent-subtle border-transparent; }
  .stats-heatmap-cell[data-level='3'] { @apply bg-accent border-transparent; }
  .stats-heatmap-cell[data-level='4'] { @apply bg-accent-hover border-transparent; }

  .stats-forecast {
    display: flex;
    align-items: flex-end;
    gap: 0.35rem;
    height: 96px;
  }
  .stats-forecast-bar {
    flex: 1;
    min-width: 0;
    border-radius: 4px 4px 0 0;
    @apply bg-accent-subtle;
    transition: height 0.3s ease;
  }
  .stats-forecast-bar--overdue {
    @apply bg-amber-500;
  }

  .stats-sparkline {
    display: flex;
    align-items: flex-end;
    gap: 2px;
    height: 64px;
  }
  .stats-sparkline-bar {
    flex: 1;
    min-width: 0;
    border-radius: 2px 2px 0 0;
    @apply bg-accent-subtle;
  }
  .stats-sparkline-bar--empty {
    @apply bg-surface-hover;
  }

  .stats-table {
    @apply w-full text-sm;
    border-collapse: collapse;
  }
  .stats-table th {
    @apply text-left text-xs font-mono text-dim uppercase tracking-wide pb-2 border-b border-line cursor-pointer select-none;
  }
  .stats-table th:hover {
    @apply text-body;
  }
  .stats-table td {
    @apply py-2 border-b border-line text-body;
  }
</style>

<script>
  import { loadJSON } from '../../lib/storage';
  import {
    dayKeyFromTimestamp,
    computeDailyCounts,
    computeHeatmap,
    computeStreak,
    computeRecallAccuracy,
    computeAvgElapsedMs,
    filterEventsSince,
    computeForecast,
    computeReviewsTrend,
    computeAccuracyTrend,
    computeUnitMasteryScores,
    computeDeckProgress,
    computeTagProgress,
    computeLearningCounts,
    type DeckMeta,
    type SrsByDeck,
    type TrendPoint,
    type ProgressRow,
  } from '../../lib/stats/aggregate';
  import { computeUnitConfidenceScores, type ConfidenceStore } from '../../lib/srs/confidence';
  import { ACHIEVEMENTS, computeGamificationStats, computeDailyGoalProgress, computeWeeklyGoalProgress } from '../../lib/gamification/rules';
  import { loadGoals, saveGoals, loadGamifyState } from '../../lib/gamification/state';

  // non-null: #fc-stats-data is rendered unconditionally above and always holds the JSON data island.
  const { deckMeta } = JSON.parse(document.getElementById('fc-stats-data')!.textContent!) as { deckMeta: DeckMeta[] };
  const events = loadJSON('fc:log', { v: 1, events: [] }).events;
  const srsByDeck: SrsByDeck = Object.fromEntries(
    deckMeta.map((d): [string, SrsByDeck[string]] => [
      d.slug,
      loadJSON<{ v: number; cards: SrsByDeck[string] }>(`fc:srs:${d.slug}`, { v: 1, cards: {} }).cards,
    ])
  );
  const confidenceByDeck: Record<string, ConfidenceStore> = Object.fromEntries(
    deckMeta.map((d): [string, ConfidenceStore] => [d.slug, loadJSON<ConfidenceStore>(`fc:confidence:${d.slug}`, {})])
  );
  const today = dayKeyFromTimestamp(Date.now());

  // --- Tabs (same mechanics as pomo.astro's tab system) ---
  function setActiveTab(tab?: string) {
    const resolved = tab === 'decks-tags' ? 'decks-tags' : tab === 'achievements' ? 'achievements' : 'overview';
    document.querySelectorAll<HTMLElement>('.tab').forEach((btn) => {
      btn.setAttribute('aria-selected', String(btn.dataset.tab === resolved));
    });
    document.getElementById('stats-panel-overview')?.classList.toggle('hidden', resolved !== 'overview');
    document.getElementById('stats-panel-decks-tags')?.classList.toggle('hidden', resolved !== 'decks-tags');
    document.getElementById('stats-panel-achievements')?.classList.toggle('hidden', resolved !== 'achievements');
  }
  document.querySelectorAll<HTMLElement>('.tab').forEach((btn) => {
    btn.addEventListener('click', () => setActiveTab(btn.dataset.tab));
  });

  // --- Compute ---
  const dailyCounts = computeDailyCounts(events);
  const heatmapCells = computeHeatmap(dailyCounts, today);
  const streak = computeStreak(dailyCounts, today);
  const learningCounts = computeLearningCounts(srsByDeck, deckMeta);
  const events30 = filterEventsSince(events, today, 30);
  const recallAccuracy30 = computeRecallAccuracy(events30);
  const recallAccuracyAllTime = computeRecallAccuracy(events);
  const avgResponse30 = computeAvgElapsedMs(events30);
  const avgResponseAllTime = computeAvgElapsedMs(events);
  const forecastBuckets = computeForecast(srsByDeck, today);
  const reviewsTrend = computeReviewsTrend(dailyCounts, today);
  const accuracyTrend = computeAccuracyTrend(events, today);
  const unitScores = computeUnitMasteryScores(srsByDeck, events);
  const confidenceScores = computeUnitConfidenceScores(confidenceByDeck);
  const deckRows = computeDeckProgress(deckMeta, srsByDeck, unitScores, today, confidenceScores);
  const tagRows = computeTagProgress(deckMeta, srsByDeck, unitScores, today, confidenceScores);
  const reviewsToday = dailyCounts[today] ?? 0;

  // --- Render: empty state ---
  // non-null: every element id below is rendered unconditionally in this page's template.
  if (events.length === 0) {
    document.getElementById('stats-empty')!.classList.remove('hidden');
    document.getElementById('stats-content')!.classList.add('hidden');
  }

  // --- Render: hero + tiles ---
  document.getElementById('stat-streak-hero')!.textContent = String(streak);
  document.getElementById('stat-learning-counts-caption')!.textContent =
    `${learningCounts.total} cards · ${learningCounts.mature} mature · ${learningCounts.learning} learning · ${learningCounts.new} new`;

  document.getElementById('stat-reviews-today')!.textContent = String(reviewsToday);
  document.getElementById('stat-day-streak')!.textContent = String(streak);

  const pct = (v: number | null) => (v === null ? '—' : `${Math.round(v * 100)}%`);
  document.getElementById('stat-recall-accuracy')!.textContent = pct(recallAccuracy30);
  document.getElementById('stat-recall-accuracy-sub')!.textContent =
    recallAccuracyAllTime === null ? '' : `all-time: ${pct(recallAccuracyAllTime)}`;

  const fmtMs = (v: number | null) => (v === null ? '—' : `${(v / 1000).toFixed(1)}s`);
  document.getElementById('stat-avg-response')!.textContent = fmtMs(avgResponse30);
  document.getElementById('stat-avg-response-sub')!.textContent =
    avgResponseAllTime === null ? '' : `all-time: ${fmtMs(avgResponseAllTime)}`;

  // --- Render: heatmap ---
  const heatmapEl = document.getElementById('stats-heatmap')!;
  heatmapCells.forEach((cell) => {
    const div = document.createElement('div');
    div.className = 'stats-heatmap-cell';
    div.dataset.level = String(cell.level);
    div.title = `${cell.date}: ${cell.count} review${cell.count === 1 ? '' : 's'}`;
    heatmapEl.appendChild(div);
  });

  // --- Render: forecast ---
  const forecastEl = document.getElementById('stats-forecast')!;
  const forecastMax = Math.max(1, ...forecastBuckets.map((b) => b.count));
  forecastBuckets.forEach((bucket) => {
    const bar = document.createElement('div');
    bar.className = 'stats-forecast-bar' + (bucket.date === 'overdue' ? ' stats-forecast-bar--overdue' : '');
    bar.style.height = `${Math.max(4, (bucket.count / forecastMax) * 100)}%`;
    bar.title = bucket.date === 'overdue' ? `Overdue: ${bucket.count}` : `${bucket.date}: ${bucket.count} due`;
    forecastEl.appendChild(bar);
  });

  // --- Render: sparklines (two separate, never a dual-axis combo chart) ---
  function renderSparkline(containerId: string, points: TrendPoint[], opts: { percent: boolean }) {
    const el = document.getElementById(containerId)!; // non-null: both call sites pass a real container id
    const numericValues = points.map((p) => p.value).filter((v): v is number => v !== null);
    const max = opts.percent ? 1 : Math.max(1, ...numericValues);
    points.forEach((p) => {
      const bar = document.createElement('div');
      if (p.value === null) {
        bar.className = 'stats-sparkline-bar stats-sparkline-bar--empty';
        bar.style.height = '8%';
        bar.title = `${p.date}: no data`;
      } else {
        bar.className = 'stats-sparkline-bar';
        bar.style.height = `${Math.max(4, (p.value / max) * 100)}%`;
        bar.title = opts.percent ? `${p.date}: ${Math.round(p.value * 100)}%` : `${p.date}: ${p.value.toFixed(1)}`;
      }
      el.appendChild(bar);
    });
  }
  renderSparkline('stats-trend-reviews', reviewsTrend, { percent: false });
  renderSparkline('stats-trend-accuracy', accuracyTrend, { percent: true });

  // --- Render: sortable tables ---
  function renderTableRows(tableId: string, rows: ProgressRow[]) {
    const tbody = document.querySelector(`#${tableId} tbody`)!; // non-null: called only with real table ids that have a <tbody>
    tbody.innerHTML = rows
      .map(
        (r) => `
      <tr>
        <td>${r.label}</td>
        <td>${r.totalReviewUnits}</td>
        <td>${r.matureCount}</td>
        <td>${r.masteryScore === null ? '—' : Math.round(r.masteryScore) + '%'}</td>
        <td>${r.confidenceScore === null ? '—' : Math.round(r.confidenceScore) + '%'}</td>
        <td>${r.nextDueCount}</td>
      </tr>
    `
      )
      .join('');
  }

  function initSortableTable(tableId: string, initialRows: ProgressRow[]) {
    let currentRows = initialRows;
    let sortKey: keyof ProgressRow | null = null;
    let ascending = true;
    renderTableRows(tableId, currentRows);

    document.querySelectorAll<HTMLElement>(`#${tableId} th[data-sort]`).forEach((th) => {
      th.addEventListener('click', () => {
        const key = (th.dataset.sort ?? '') as keyof ProgressRow;
        ascending = sortKey === key ? !ascending : true;
        sortKey = key;
        currentRows = [...currentRows].sort((a, b) => {
          const av = a[key];
          const bv = b[key];
          if (av === null) return 1;
          if (bv === null) return -1;
          // Values in one column are homogeneously typed across rows; the typeof check picks the comparison.
          if (typeof av === 'string') return ascending ? av.localeCompare(bv as string) : (bv as string).localeCompare(av);
          return ascending ? av - (bv as number) : (bv as number) - av;
        });
        renderTableRows(tableId, currentRows);
      });
    });
  }

  initSortableTable('stats-decks-table', deckRows);
  initSortableTable('stats-tags-table', tagRows);

  // --- Gamification (Achievements tab) ---
  const goals = loadGoals();
  const gamify = loadGamifyState();
  const gamifyStats = computeGamificationStats({ events, gamify, deckMeta, srsByDeck, unitScores, currentStreak: streak });
  const dailyGoalProgress = computeDailyGoalProgress(dailyCounts, today, goals.dailyReviewTarget);
  const weeklyGoalProgress = computeWeeklyGoalProgress(dailyCounts, today, goals.weeklyDaysTarget);

  // non-null: every element id below is rendered unconditionally in this page's template.
  document.getElementById('gamify-stat-level')!.textContent = String(gamifyStats.level);
  document.getElementById('gamify-stat-xp')!.textContent = String(gamifyStats.totalXp);
  document.getElementById('gamify-stat-reviews')!.textContent = String(gamifyStats.totalReviewsEver);
  const unlockedCount = ACHIEVEMENTS.filter((a) => a.check(gamifyStats)).length;
  document.getElementById('gamify-stat-badges')!.textContent = `${unlockedCount}/${ACHIEVEMENTS.length}`;

  const goalDailyInput = document.getElementById('goal-daily-input') as HTMLInputElement;
  const goalWeeklyInput = document.getElementById('goal-weekly-input') as HTMLInputElement;
  goalDailyInput.value = String(goals.dailyReviewTarget);
  goalWeeklyInput.value = String(goals.weeklyDaysTarget);
  document.getElementById('goal-daily-bar')!.style.width = `${Math.round(dailyGoalProgress.fraction * 100)}%`;
  document.getElementById('goal-daily-label')!.textContent = `${dailyGoalProgress.current}/${dailyGoalProgress.target} today`;
  document.getElementById('goal-weekly-bar')!.style.width = `${Math.round(weeklyGoalProgress.fraction * 100)}%`;
  document.getElementById('goal-weekly-label')!.textContent = `${weeklyGoalProgress.daysStudied}/${weeklyGoalProgress.target} days this week`;

  goalDailyInput.addEventListener('change', () => {
    goals.dailyReviewTarget = Math.max(1, Number(goalDailyInput.value) || 1);
    saveGoals(goals);
    location.reload();
  });
  goalWeeklyInput.addEventListener('change', () => {
    goals.weeklyDaysTarget = Math.max(1, Math.min(7, Number(goalWeeklyInput.value) || 1));
    saveGoals(goals);
    location.reload();
  });

  const badgeGridEl = document.getElementById('badge-grid')!;
  ACHIEVEMENTS.forEach((a) => {
    const unlocked = a.check(gamifyStats);
    const card = document.createElement('div');
    card.className = 'badge' + (unlocked ? ' unlocked' : '');
    card.innerHTML = `<div class="badge-icon">${a.icon}</div><div class="badge-label">${a.label}</div><div class="badge-desc">${a.desc}</div>`;
    badgeGridEl.appendChild(card);
  });
</script>
