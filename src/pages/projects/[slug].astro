---
import { getCollection, render } from 'astro:content';
import Page from '../../layouts/Page.astro';
import MermaidRenderer from '../../components/MermaidRenderer.astro';

export async function getStaticPaths() {
  // Two classes of entry are skipped here, both because rendering their prose
  // body would shadow the real page with an empty or stale write-up:
  //   - `dedicated`: has a bespoke page in this repo (interactive family tree /
  //     k8s manifest explainer); the .md only feeds the /projects index card.
  //   - `externalUrl` set: the write-up lives on its own site (a separate repo's
  //     Pages deploy, e.g. /signal-forge/); the cards link straight there and
  //     astro.config.mjs redirects /projects/<id> onward.
  // (Declared inside getStaticPaths: Astro runs it in isolation from the
  // component module scope.)
  const dedicated = new Set(['family-tree', 'k8s-manifest-explainer']);
  const projects = await getCollection('projects');
  return projects
    .filter((project) => !dedicated.has(project.id) && !project.data.externalUrl)
    .map((project) => ({
      params: { slug: project.id },
      props: { project },
    }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, description, tags, github, demo, status, results } = project.data;

const statusColor: Record<string, string> = {
  active: 'text-success bg-success/10 border-success/20',
  wip: 'text-yellow-400 bg-yellow-400/10 border-yellow-400/20',
  archived: 'text-dim bg-dim/10 border-dim/20',
};

const statusLabel: Record<string, string> = {
  active: 'Active',
  wip: 'WIP',
  archived: 'Archived',
};
---

<Page title={`${title} — Amit Singh`} description={description}>
  <div class="max-w-9xl mx-auto px-6">
      <header class="mb-12">
        <div class="flex flex-wrap gap-2 mb-4">
          {tags.map((tag) => <span class="tag">{tag}</span>)}
        </div>

        <div class="flex items-start gap-4 mb-4">
          <h1 class="text-3xl md:text-4xl font-bold text-ink leading-tight flex-1">
            {title}
          </h1>
          <span class={`flex-shrink-0 mt-1 px-2.5 py-1 text-xs font-mono rounded-full border ${statusColor[status]}`}>
            {statusLabel[status]}
          </span>
        </div>

        <p class="text-lg text-muted mb-6">{description}</p>

        {(github || demo) && (
          <div class="flex items-center gap-4 border-t border-line pt-4">
            {github && (
              <a
                href={github}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-2 text-sm text-muted hover:text-accent transition-colors font-mono"
              >
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                </svg>
                View source
              </a>
            )}
            {demo && (
              <a
                href={demo}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-2 text-sm text-muted hover:text-accent transition-colors font-mono"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                </svg>
                Live demo
              </a>
            )}
          </div>
        )}
      </header>

      {results.length > 0 && (
        <div class="mb-10 p-6 rounded-xl border border-line bg-surface/50">
          <p class="text-xs font-mono text-dim uppercase tracking-widest mb-3">Impact</p>
          <ul class="space-y-2">
            {results.map((result) => (
              <li class="text-sm text-body flex gap-2">
                <span class="text-accent">›</span>
                {result}
              </li>
            ))}
          </ul>
        </div>
      )}

      <article class="project-body prose prose-invert prose-doc">
        <Content />
      </article>

      <div class="mt-16 pt-8 border-t border-line flex items-center justify-between">
        <a href="/projects" class="text-sm text-accent hover:text-accent-hover font-mono flex items-center gap-2 transition-colors">
          ← All projects
        </a>
        <a href="/" class="text-sm text-dim hover:text-body transition-colors">Home</a>
      </div>

    </div>

  <MermaidRenderer />
</Page>

<style is:global>
  /* Project write-ups break the diagram out of the prose column to full width
     and let it scroll horizontally (some are wide). Scoped to this route via
     the wrapper class so notes/blog keep the centered treatment. */
  .project-body .mermaid {
    display: block;
    overflow-x: auto;
    overflow-y: hidden;
    padding: 1.5rem;
    margin: 1.5rem calc(-50vw + 50%);
    background: color-mix(in srgb, var(--color-surface) 60%, transparent);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
  }
  .project-body .mermaid svg {
    display: block;
    height: auto;
    border-radius: 0.5rem;
  }
</style>
