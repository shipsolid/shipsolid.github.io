---
import ToolLayout from '../../layouts/ToolLayout.astro';
---

<ToolLayout
  slug="cardinality-calculator"
  description="Estimate active time-series count from a label set, rank the contributors, and flag high-cardinality labels. Client-side only, no sign-up, no tracking."
  intro="Active series is the product of every label's distinct-value count. Add your label set below to size it, spot the dominant labels, and catch the unbounded ones before they ship. Everything stays in your browser."
>

  <div class="card">
    <div class="flex items-center justify-between">
      <h2 class="section-label">Labels</h2>
      <button type="button" id="cc-add" class="btn-outline text-xs">Add label</button>
    </div>
    <div class="mt-4 space-y-2" id="cc-labels"></div>
  </div>

  <div class="card mt-6">
    <h2 class="section-label">Settings</h2>
    <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-4">
      <label class="text-xs font-mono text-dim">
        Scrape interval (seconds)
        <input
          id="cc-interval"
          type="number"
          step="1"
          min="1"
          value="15"
          class="mt-1 w-full bg-field border border-line rounded-lg px-3 py-2 text-sm text-ink outline-none focus:border-accent focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-accent/70"
        />
      </label>
      <label class="text-xs font-mono text-dim">
        Cost per million series / month (USD, optional)
        <input
          id="cc-cost"
          type="number"
          step="0.01"
          min="0"
          placeholder="e.g. 8"
          class="mt-1 w-full bg-field border border-line rounded-lg px-3 py-2 text-sm text-ink outline-none focus:border-accent focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-accent/70"
        />
      </label>
    </div>
    <p id="cc-error" class="mt-3 text-sm text-red-400 font-mono hidden"></p>
  </div>

  <div id="cc-result" class="card mt-6"></div>

  <div class="card mt-6">
    <h2 class="section-label">Notes</h2>
    <ul id="cc-notes" class="mt-3 space-y-1 text-xs text-dim font-mono list-disc pl-5"></ul>
  </div>

</ToolLayout>

<script>
  import { calcCardinality } from '../../lib/tools/cardinality-calculator';
  import type { LabelDef } from '../../lib/tools/cardinality-calculator';
  import { loadJSON, saveJSON } from '../../lib/storage';

  const STORAGE_KEY = 'tools:cardinality-calculator:input';

  interface CardinalityState {
    labels: LabelDef[];
    scrapeIntervalSeconds: number;
    costPerMillionSeriesUsd: number | '';
  }

  const DEFAULT_STATE: CardinalityState = {
    labels: [
      { name: 'service', cardinality: 100 },
      { name: 'environment', cardinality: 4 },
      { name: 'region', cardinality: 6 },
      { name: 'pod', cardinality: 500 },
    ],
    scrapeIntervalSeconds: 15,
    costPerMillionSeriesUsd: '',
  };

  const state: CardinalityState = loadJSON<CardinalityState>(STORAGE_KEY, DEFAULT_STATE);
  if (!Array.isArray(state.labels) || state.labels.length === 0) state.labels = [{ name: '', cardinality: 1 }];

  const labelsEl = document.getElementById('cc-labels') as HTMLElement | null;
  const intervalEl = document.getElementById('cc-interval') as HTMLInputElement | null;
  const costEl = document.getElementById('cc-cost') as HTMLInputElement | null;
  const errorEl = document.getElementById('cc-error');
  const resultEl = document.getElementById('cc-result');
  const notesEl = document.getElementById('cc-notes');
  const addBtn = document.getElementById('cc-add');

  if (intervalEl) intervalEl.value = String(state.scrapeIntervalSeconds);
  if (costEl) costEl.value = state.costPerMillionSeriesUsd === '' ? '' : String(state.costPerMillionSeriesUsd);

  const inputClass =
    'w-full bg-field border border-line rounded-lg px-3 py-2 text-sm text-ink outline-none focus:border-accent focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-accent/70';

  function persist() {
    saveJSON(STORAGE_KEY, state);
  }

  function fmt(n: number): string {
    if (!Number.isFinite(n)) return '∞';
    if (n >= 1000) return Math.round(n).toLocaleString();
    return (Math.round(n * 100) / 100).toLocaleString();
  }

  const RISK_CLASS: Record<string, string> = {
    low: 'bg-emerald-950 text-emerald-400 border border-emerald-900',
    medium: 'bg-amber-950 text-amber-400 border border-amber-900',
    high: 'bg-red-950 text-red-400 border border-red-900',
  };

  function renderLabelRows() {
    if (!labelsEl) return;
    labelsEl.innerHTML = '';
    state.labels.forEach((label, index) => {
      const row = document.createElement('div');
      row.className = 'flex gap-2 items-center';
      row.innerHTML = `
        <input type="text" data-role="name" data-index="${index}" placeholder="label name"
          class="${inputClass} flex-1 min-w-0 font-mono" />
        <input type="number" step="1" min="1" data-role="card" data-index="${index}" placeholder="distinct values"
          class="${inputClass} w-40 shrink-0 font-mono" />
        <button type="button" data-role="remove" data-index="${index}" class="btn-outline text-xs shrink-0">✕</button>
      `;
      (row.querySelector('[data-role="name"]') as HTMLInputElement).value = label.name;
      (row.querySelector('[data-role="card"]') as HTMLInputElement).value = String(label.cardinality);
      labelsEl.appendChild(row);
    });
  }

  function readInputs() {
    state.scrapeIntervalSeconds = Number(intervalEl?.value);
    const rawCost = costEl?.value?.trim() ?? '';
    state.costPerMillionSeriesUsd = rawCost === '' ? '' : Number(rawCost);
    persist();
  }

  function run() {
    readInputs();
    if (!errorEl || !resultEl || !notesEl) return;

    try {
      const result = calcCardinality({
        labels: state.labels.map((l) => ({ name: l.name, cardinality: l.cardinality })),
        scrapeIntervalSeconds: state.scrapeIntervalSeconds,
        costPerMillionSeriesUsd:
          state.costPerMillionSeriesUsd === '' ? undefined : state.costPerMillionSeriesUsd,
      });
      errorEl.classList.add('hidden');

      const contributorRows = result.contributors
        .map(
          (c) => `
          <tr>
            <td class="px-3 py-1.5 font-mono text-body border-b border-line">${c.name}</td>
            <td class="px-3 py-1.5 font-mono text-body border-b border-line text-right">${fmt(c.cardinality)}</td>
            <td class="px-3 py-1.5 font-mono text-dim border-b border-line text-right">${c.sharePercent}%</td>
          </tr>`
        )
        .join('');

      const churn =
        result.highChurnFlags.length === 0
          ? '<p class="text-xs text-dim font-mono mt-2">No high-cardinality labels flagged.</p>'
          : `<div class="mt-3 rounded-lg border border-red-900 bg-red-950/40 p-3">
               <p class="text-xs font-mono text-red-400 mb-1">High cardinality — do not use as a metric label:</p>
               <p class="text-sm font-mono text-ink">${result.highChurnFlags.join(', ')}</p>
               <p class="text-xs text-dim mt-1">Move these to logs, traces, or exemplars.</p>
             </div>`;

      resultEl.innerHTML = `
        <h2 class="section-label mb-3">Result</h2>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 text-sm font-mono">
          <div><div class="text-dim text-xs">Active series</div><div class="text-ink">${fmt(result.activeSeries)}</div></div>
          <div><div class="text-dim text-xs">Samples / sec</div><div class="text-ink">${fmt(result.samplesPerSecond)}</div></div>
          <div><div class="text-dim text-xs">Est. ingest / mo</div><div class="text-ink">${result.estMonthlyIngestUsd === null ? '—' : '$' + fmt(result.estMonthlyIngestUsd)}</div></div>
          <div><div class="text-dim text-xs">Risk</div><div><span class="tag ${RISK_CLASS[result.risk]}">${result.risk}</span></div></div>
        </div>
        <p class="mt-3 text-sm font-mono text-muted">Verdict: <span class="text-ink">${result.verdict}</span></p>
        ${churn}
        <h3 class="section-label mt-6 mb-2">Contributors</h3>
        <div class="overflow-x-auto">
          <table class="w-full border-collapse text-sm">
            <thead><tr>
              <th class="text-left px-3 py-1.5 font-mono text-xs text-dim border-b border-line">Label</th>
              <th class="text-right px-3 py-1.5 font-mono text-xs text-dim border-b border-line">Distinct</th>
              <th class="text-right px-3 py-1.5 font-mono text-xs text-dim border-b border-line">Share</th>
            </tr></thead>
            <tbody>${contributorRows}</tbody>
          </table>
        </div>
      `;

      notesEl.innerHTML = result.notes.map((n) => `<li>${n}</li>`).join('');
    } catch (err) {
      const message = err instanceof Error ? err.message : String(err);
      errorEl.textContent = message;
      errorEl.classList.remove('hidden');
      resultEl.innerHTML = '<h2 class="section-label mb-3">Result</h2><p class="text-sm text-red-400 font-mono">Fix the error above to see the estimate.</p>';
    }
  }

  labelsEl?.addEventListener('input', (event) => {
    const target = event.target as HTMLElement;
    const index = Number(target.dataset.index);
    if (Number.isNaN(index) || !state.labels[index]) return;
    if (target.dataset.role === 'name') state.labels[index].name = (target as HTMLInputElement).value;
    if (target.dataset.role === 'card') state.labels[index].cardinality = Number((target as HTMLInputElement).value);
    persist();
    run();
  });

  labelsEl?.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    if (target.dataset.role !== 'remove') return;
    const index = Number(target.dataset.index);
    state.labels.splice(index, 1);
    if (state.labels.length === 0) state.labels.push({ name: '', cardinality: 1 });
    persist();
    renderLabelRows();
    run();
  });

  addBtn?.addEventListener('click', () => {
    state.labels.push({ name: '', cardinality: 10 });
    persist();
    renderLabelRows();
    run();
  });

  intervalEl?.addEventListener('input', run);
  costEl?.addEventListener('input', run);

  renderLabelRows();
  run();
</script>
