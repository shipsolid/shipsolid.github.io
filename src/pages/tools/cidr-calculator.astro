---
import ToolLayout from '../../layouts/ToolLayout.astro';
---

<ToolLayout
  slug="cidr-calculator"
  description="IPv4 CIDR subnet calculator — network/broadcast address, subnet mask, wildcard mask, and usable host range. Client-side only, no sign-up, no tracking."
  intro="IPv4 subnet math — network and broadcast addresses, masks, and usable host range. Everything stays in your browser."
>

  <div class="card">
        <h2 class="section-label">Subnet</h2>
        <form id="cidr-form" class="mt-4 grid grid-cols-1 gap-4">
          <label class="text-xs font-mono text-dim">
            CIDR (e.g. 10.0.0.0/24)
            <input
              id="cidr-input"
              type="text"
              placeholder="10.0.0.0/24"
              class="mt-1 w-full bg-field border border-line rounded-lg px-3 py-2 text-sm text-ink outline-none focus:border-accent focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-accent/70"
            />
          </label>
          <div>
            <button type="submit" class="btn-primary">Calculate</button>
          </div>
        </form>
      </div>
      <div id="cidr-result" class="card mt-6"></div>

</ToolLayout>

<script>
import { calcCidr } from '../../lib/tools/cidr-calculator';
import { loadJSON, saveJSON } from '../../lib/storage';

(() => {
  const STORAGE_KEY = 'tools:cidr-calculator:input';
  const DEFAULT_INPUT = '10.0.0.0/24';

  const input: string = loadJSON<string>(STORAGE_KEY, DEFAULT_INPUT);

  const form = document.getElementById('cidr-form');
  const cidrInput = document.getElementById('cidr-input') as HTMLInputElement | null;
  const result = document.getElementById('cidr-result');

  if (cidrInput) cidrInput.value = input;

  function renderResult(container: HTMLElement | null, lines: string[]) {
    if (!container) return;
    container.innerHTML = `
      <h3 class="section-label mb-3">Result</h3>
      <div class="space-y-1 text-sm font-mono text-body">
        ${lines.map((line) => `<div>${line}</div>`).join('')}
      </div>
    `;
  }

  function renderError(container: HTMLElement | null, err: unknown) {
    if (!container) return;
    const message = err instanceof Error ? err.message : String(err);
    container.innerHTML = `<div class="text-sm text-red-400 font-mono">${message}</div>`;
  }

  function run() {
    const cidrString = cidrInput?.value?.trim() ?? '';
    saveJSON(STORAGE_KEY, cidrString);

    try {
      const r = calcCidr(cidrString);
      renderResult(result, [
        `Network address: ${r.networkAddress}`,
        `Broadcast address: ${r.broadcastAddress}`,
        `Subnet mask: ${r.subnetMask}`,
        `Wildcard mask: ${r.wildcardMask}`,
        `Usable range: ${r.firstUsable ?? '—'} – ${r.lastUsable ?? '—'}`,
        `Total hosts: ${r.totalHosts.toLocaleString()}`,
        `Usable hosts: ${r.usableHosts.toLocaleString()}`,
      ]);
    } catch (err) {
      renderError(result, err);
    }
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    run();
  });
  run();
})();
</script>
