---
import Page from '../../layouts/Page.astro';
import { groupedTools } from '../../data/tools';

const families = groupedTools();
---

<Page
  title="Tools — Amit Singh"
  description="A browser-native engineering workbench — SRE calculators, cardinality and telemetry-cost estimators, incident timelines, query builders, an ADR builder, and personal workspaces. Everything runs client-side, no sign-up, no tracking."
>
  <div class="max-w-9xl mx-auto px-6">
      <header class="mb-12 max-w-3xl">
        <div class="flex flex-wrap gap-2 mb-4">
          <span class="tag">tools</span>
          <span class="tag">local-first</span>
        </div>
        <h1 class="text-3xl md:text-4xl font-bold text-ink leading-tight mb-3">
          Tools
        </h1>
        <p class="text-muted">
          A browser-native workbench for SRE, observability, and system-design work — grouped into
          <span class="font-mono text-body">Build</span>,
          <span class="font-mono text-body">Observe</span>,
          <span class="font-mono text-body">Operate</span>, and
          <span class="font-mono text-body">Focus</span>.
          Everything runs in your browser and persists locally — no account, no server.
        </p>
      </header>

      {families.map(({ family, tools }) => (
        <section id={family.id} class="scroll-mt-28 mb-14">
          <h2 class="section-label">{family.label}</h2>
          <p class="text-muted mt-1 mb-5">{family.blurb}</p>

          <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4">
            {tools.map((tool) =>
              tool.status === 'planned' ? (
                <div class="card opacity-60 flex flex-col justify-center min-h-[13rem]">
                  <div class="flex flex-wrap gap-2 mb-3">
                    {tool.tags.map((tag) => <span class="tag">{tag}</span>)}
                    <span class="tag">planned</span>
                  </div>
                  <h3 class="text-lg font-semibold text-ink mb-2">
                    {tool.title}
                  </h3>
                  <p class="text-sm text-muted">{tool.description}</p>
                </div>
              ) : (
                <a
                  href={tool.href}
                  class="card flex flex-col justify-center min-h-[13rem] hover:border-accent/50 transition-colors duration-200"
                >
                  <div class="flex flex-wrap gap-2 mb-3">
                    {tool.tags.map((tag) => <span class="tag">{tag}</span>)}
                    {tool.status === 'beta' && <span class="tag">beta</span>}
                  </div>
                  <h3 class="text-lg font-semibold text-ink mb-2">
                    {tool.title}
                  </h3>
                  <p class="text-sm text-muted">{tool.description}</p>
                </a>
              )
            )}
          </div>
        </section>
      ))}

    </div>

</Page>
