---
import ToolLayout from '../../layouts/ToolLayout.astro';
---

<ToolLayout
  slug="metric-naming-validator"
  description="Check a metric name against Prometheus or OpenTelemetry naming conventions, with a suggested instrument type. Client-side only, no sign-up, no tracking."
  intro="Paste a metric name and see it checked against the naming rules — charset, snake_case, base units, reserved suffixes — plus a guess at the instrument type. Everything stays in your browser."
>

  <div class="tabs" role="tablist">
    <button class="tab" data-conv="prometheus" role="tab" aria-selected="true" type="button">Prometheus</button>
    <button class="tab" data-conv="otel" role="tab" aria-selected="false" type="button">OpenTelemetry</button>
  </div>

  <div class="card">
    <h2 class="section-label">Metric name</h2>
    <input
      id="mn-input"
      type="text"
      placeholder="http_request_duration_seconds"
      class="mt-4 w-full bg-field border border-line rounded-lg px-3 py-2 text-sm text-ink font-mono outline-none focus:border-accent focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-accent/70"
    />
  </div>

  <div id="mn-summary" class="card mt-6"></div>

  <div class="card mt-6">
    <h2 class="section-label">Checks</h2>
    <ul id="mn-checks" class="mt-4 space-y-3"></ul>
  </div>

</ToolLayout>

<script>
  import { validateMetricName } from '../../lib/tools/metric-naming-validator';
  import type { MetricConvention } from '../../lib/tools/metric-naming-validator';
  import { loadJSON, saveJSON } from '../../lib/storage';

  const STORAGE_KEY = 'tools:metric-naming-validator:state';

  interface MnState {
    name: string;
    convention: MetricConvention;
  }

  const DEFAULT_STATE: MnState = { name: 'http_request_duration_seconds', convention: 'prometheus' };
  const state: MnState = { ...DEFAULT_STATE, ...loadJSON<Partial<MnState>>(STORAGE_KEY, {}) };
  if (state.convention !== 'prometheus' && state.convention !== 'otel') state.convention = 'prometheus';

  const inputEl = document.getElementById('mn-input') as HTMLInputElement | null;
  const summaryEl = document.getElementById('mn-summary');
  const checksEl = document.getElementById('mn-checks');
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.tab'));

  if (inputEl) inputEl.value = state.name;

  function persist() {
    saveJSON(STORAGE_KEY, state);
  }

  function escapeHtml(s: string): string {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  function syncTabs() {
    tabs.forEach((btn) => btn.setAttribute('aria-selected', String(btn.dataset.conv === state.convention)));
  }

  function run() {
    if (!summaryEl || !checksEl) return;
    state.name = inputEl?.value ?? '';
    persist();

    const result = validateMetricName(state.name, state.convention);
    const scorePct = Math.round(result.score * 100);
    const passCount = result.checks.filter((c) => c.pass).length;

    const suggestionsHtml =
      result.suggestions.length === 0
        ? ''
        : `<div class="mt-3 rounded-lg border border-accent/40 bg-accent/10 p-3">
             <p class="text-xs font-mono text-accent mb-1">Suggestions</p>
             <ul class="list-disc pl-5 space-y-1 text-sm text-ink">
               ${result.suggestions.map((s) => `<li>${escapeHtml(s)}</li>`).join('')}
             </ul>
           </div>`;

    summaryEl.innerHTML = `
      <h2 class="section-label mb-3">Summary</h2>
      <div class="flex flex-wrap items-center gap-3 text-sm font-mono">
        <span class="tag">${passCount}/${result.checks.length} checks pass · ${scorePct}%</span>
        <span class="text-muted">Suggested type:
          <span class="text-ink">${result.suggestedType}</span>
        </span>
      </div>
      ${suggestionsHtml}
    `;

    checksEl.innerHTML = result.checks
      .map((c) => {
        const icon = c.pass
          ? '<span class="text-green-400">✓</span>'
          : '<span class="text-red-400">✗</span>';
        return `
          <li class="py-2 border-b border-line last:border-0">
            <div class="flex items-start gap-3">
              <span class="mt-0.5">${icon}</span>
              <div class="flex-1 min-w-0">
                <div class="font-mono text-sm text-ink">${escapeHtml(c.label)}</div>
                <div class="text-xs text-dim mt-0.5">${escapeHtml(c.detail)}</div>
              </div>
            </div>
          </li>`;
      })
      .join('');
  }

  tabs.forEach((btn) => {
    btn.addEventListener('click', () => {
      const conv = btn.dataset.conv as MetricConvention | undefined;
      if (conv !== 'prometheus' && conv !== 'otel') return;
      state.convention = conv;
      syncTabs();
      run();
    });
  });

  inputEl?.addEventListener('input', run);

  syncTabs();
  run();
</script>
